# ─────────────────────────────────────────────────────────────────────────────
# StudyFlow AI — SERVER environment template
#
# 1. Copy this file to `server/.env`  (cp server/.env.example server/.env)
# 2. Replace every <placeholder> with a REAL value for local development.
# 3. In production, set these via your platform's secret manager — do NOT ship a
#    .env file. `server/.env` is gitignored; this `.env.example` is the ONLY env
#    file that should be committed, and it must contain placeholders ONLY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # set to "production" in prod
PORT=5000

# ── CORS / allowed origins ───────────────────────────────────────────────────
# ALLOWED_ORIGINS (comma-separated) takes precedence when set — use it in prod.
#   ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=
CLIENT_URL=http://localhost:3000
# ADMIN_PANEL_URL=https://admin.yourdomain.com

# ── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED — the server exits on connection failure. Atlas SRV or standard URI.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/studyflow?retryWrites=true&w=majority

# ── JWT (session signing) ────────────────────────────────────────────────────
# Use a long, RANDOM secret (>= 256 bits). Generate one with:
#   openssl rand -hex 32
#   (or)  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-with: openssl rand -hex 32>

# ── AI providers ─────────────────────────────────────────────────────────────
# Groq — chat coach + regen advice  (https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mistral — PDF syllabus extraction  (https://console.mistral.ai)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Gmail SMTP via nodemailer) ────────────────────────────────────────
# EMAIL_PASS must be a Google "App Password" (16 chars), NOT your login password.
EMAIL_SERVICE=gmail
EMAIL_USER=your-support-address@gmail.com
EMAIL_PASS=<16-char-google-app-password>
# Optional From header; defaults to "StudyFlow AI <EMAIL_USER>"
# EMAIL_FROM=StudyFlow AI <your-support-address@gmail.com>

# ── Razorpay (payments) ──────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. rzp_test_* in dev, rzp_live_* in prod.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
# Dashboard → Settings → Webhooks (events: payment.captured, payment.failed).
# REQUIRED for Pro to be auto-granted after payment.
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# ── Admin (guards /api/admin/* and the /admin-panel page) ────────────────────
# Use a long RANDOM string:  openssl rand -hex 24
ADMIN_SECRET=<generate-with: openssl rand -hex 24>
