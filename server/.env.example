# ─────────────────────────────────────────────────────────────────────────────
# StudyFlow AI — SERVER environment template
#
# 1. Copy this file to `server/.env`  (cp server/.env.example server/.env)
# 2. Replace every <placeholder> with a REAL value for local development.
# 3. In production, set these via your platform's secret manager — do NOT ship a
#    .env file. `server/.env` is gitignored; this `.env.example` is the ONLY env
#    file that should be committed, and it must contain placeholders ONLY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # set to "production" in prod
PORT=5000

# Deployment model: SAME-ORIGIN. In production Express serves the built React
# app (client/dist) and the SPA calls the API via relative /api/* on the same
# origin. Build the client first:  cd client && npm run build  (or `npm run
# build` at the repo root), then start the server with NODE_ENV=production.

# ── Proxy / TLS ──────────────────────────────────────────────────────────────
# When running behind a reverse proxy / load balancer (almost always in prod),
# Express must trust it so secure cookies and real client IPs (for rate limiting)
# work. Defaults to 1 (trust first hop) when NODE_ENV=production, off in dev.
# Override with a hop count, "true"/"false", or an IP/subnet list if needed.
# TRUST_PROXY=1

# ── CORS / allowed origins ───────────────────────────────────────────────────
# ALLOWED_ORIGINS (comma-separated) takes precedence when set — REQUIRED in prod.
# In the same-origin model the SPA shares the API origin, so list that origin.
# If unset in prod, CORS falls back to CLIENT_URL (if provided).
#   ALLOWED_ORIGINS=https://app.yourdomain.com
ALLOWED_ORIGINS=
CLIENT_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED — the server exits on connection failure. Atlas SRV or standard URI.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/studyflow?retryWrites=true&w=majority
# Optional DNS override for the connection. Only needed on hosts where Node's
# resolver can't read the system DNS (e.g. some Windows setups) and falls back
# to 127.0.0.1, breaking mongodb+srv SRV lookups. Normal hosts can leave unset.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# ── JWT (session signing) ────────────────────────────────────────────────────
# Use a long, RANDOM secret (>= 256 bits). Generate one with:
#   openssl rand -hex 32
#   (or)  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-with: openssl rand -hex 32>

# ── AI providers ─────────────────────────────────────────────────────────────
# Groq — AI Coach chat and schedule regeneration advice (https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Current developer-tier chat model; override if your Groq account uses another model.
GROQ_MODEL=openai/gpt-oss-120b
# Gemini API — PDF syllabus extraction; free tier available (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# ── Email (Gmail SMTP via nodemailer) ────────────────────────────────────────
# EMAIL_PASS must be a Google "App Password" (16 chars), NOT your login password.
EMAIL_SERVICE=gmail
EMAIL_USER=your-support-address@gmail.com
EMAIL_PASS=<16-char-google-app-password>
# Optional From header; defaults to "StudyFlow AI <EMAIL_USER>"
# EMAIL_FROM=StudyFlow AI <your-support-address@gmail.com>

# ── MongoDB Atlas network allowlist (task 3.5 — manual, no code) ──────────────
# Atlas → Network Access currently allows 0.0.0.0/0. Before production, restrict
# it to your production egress IP/CIDR. This is a dashboard
# setting and cannot be configured from this repo.
